{
  "name": "quadro-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Réplica 3D do quadro de formandos do Colégio Marista Pio X — Turma 2003 (Electron + Three.js)",
  "main": "electron/main.js",
  "scripts": {
    "build": "esbuild src/app.js --bundle --outfile=dist/app.js --format=iife --target=chrome122",
    "watch": "esbuild src/app.js --bundle --outfile=dist/app.js --format=iife --target=chrome122 --watch",
    "prestart": "npm run build",
    "start": "electron ."
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "esbuild": "^0.24.0"
  }
}
